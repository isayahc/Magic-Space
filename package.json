{
  "name": "magic-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-weight versus closed-source LLM scene authoring with Comfy Cloud and OpenIndustries",
  "scripts": {
    "start": "node serve.mjs",
    "evaluate": "node --import tsx evaluate.mjs",
    "workflows": "node workflows.mjs",
    "agent": "node scripts/agent.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/smoke.test.mjs scripts/station.test.mjs scripts/characters.test.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0"
  }
}
